{
  "name": "@beside-pet/backoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Beside Pet operator backoffice (Next.js, Feature-Sliced Design)",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
