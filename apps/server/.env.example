# Rust 서버(beside-pet-server)가 읽는 환경 변수. 이름은 옛 TS API 와 같고, 환경을 고르는 APP_ENV 만 예외다
# (NODE_ENV 는 더 읽지 않는다).
# 값은 환경마다 파일 하나에 넣는다(둘 다 gitignore). APP_ENV 가 파일을 고른다:
#   .env.production  → APP_ENV=production. 실제로 쓰는 환경(pnpm prod:up 의 컨테이너가 env_file 로 받는다)
#   .env.sandbox     → APP_ENV=sandbox. 개발, 테스트, 실측(pnpm dev). DB 테스트(cargo test)도 이 파일의 DATABASE_URL 을 읽는다
# 파일은 서버를 띄운 디렉터리에서 먼저 찾고, 없으면 이 크레이트의 디렉터리(apps/server)에서 찾는다.
# 이미 프로세스 환경에 있는 값은 파일이 덮지 않는다. 파일이 없으면 프로세스 환경만 쓴다.

# --- Server ---
PORT=3000
# production | sandbox. 없거나 다른 값이면 기동하지 않는다. 프로세스 환경에서만 읽는다(파일 이름을 이 값이 정하므로
# 파일 안에 적어도 고르지 못한다). production 이면 JWT_SECRET 이 필수이고 모든 주소(0.0.0.0)에 열며,
# sandbox 면 두 루프백(127.0.0.1, ::1)에만 연다. pnpm dev 는 sandbox 로 띄운다.
APP_ENV=sandbox
# 로그인 쿠키에 Secure 를 붙이는가: true | false(대소문자 무시). 다른 값이면 기동하지 않는다.
# 없으면 APP_ENV=production 일 때만 붙인다. http 루프백의 컨테이너(pnpm prod:up)는 false 로 둔다.
COOKIE_SECURE=
# 쿠키를 실은 브라우저 요청을 허용하는 출처(쉼표로 나눈 목록, 예: http://localhost:3001). 목록 밖 출처에는 CORS 헤더를
# 내지 않는다. production 이면 필수이고 없거나 비면 기동하지 않는다. sandbox 에서 비우면 요청의 출처를 그대로 허용한다.
ALLOWED_ORIGINS=

# --- PostgreSQL (필수: 없으면 기동하지 않는다) ---
# sandbox: pnpm sandbox:up(또는 pnpm db:up)의 127.0.0.1:5433. production 컨테이너는 compose 가 정한다.
DATABASE_URL=postgres://beside:beside@127.0.0.1:5433/besidepet
# true 면 TLS 로 붙는다(관리형 DB).
DATABASE_SSL=false

# --- Auth (JWT httpOnly cookie). production 에서는 JWT_SECRET 이 필수다 ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=7d

# --- 모델(서버 쪽에만 둔다. 화면에 내보내지 않는다. ADR-0016) ---
# 기본 공급자: anthropic | ollama. 없으면 anthropic. 다른 값이면 기동하지 않는다.
# 기본 공급자의 설정만 필수다: anthropic 이면 ANTHROPIC_API_KEY, ollama 면 LLM_MODEL.
LLM_PROVIDER=anthropic
# 기본 모델. 없으면 CLAUDE_MODEL(호환용, anthropic 에만), 그것도 없으면 claude-haiku-4-5.
# ollama 예: LLM_PROVIDER=ollama, LLM_MODEL=gemma4:26b-a4b-it-q4_K_M (설치된 모델 이름)
LLM_MODEL=claude-haiku-4-5
CLAUDE_MODEL=claude-haiku-4-5
# Anthropic. 키가 있을 때만 Anthropic 공급자를 등록한다.
ANTHROPIC_API_KEY=
# 기본 https://api.anthropic.com. 테스트나 프록시에서 바꾼다.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Ollama. 기본 http://127.0.0.1:11434. 컨테이너 안의 서버는 http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# true 일 때만 생각(thinking)을 켠다. gemma4 는 켜면 답이 빌 수 있어 기본은 끈다.
OLLAMA_THINK=false

# --- 답 판정기(살피기 층, ADR-0031) ---
# 생성 뒤 답의 상투성 판정기: off | haiku | systemone. 없으면 off. 다른 값이면 기동하지 않는다.
REPLY_JUDGE=off
# systemone 판정기의 주소(POST {주소}/v1/systemone). 본문이 가므로 루프백을 쓴다(아니면 기동 때 경고).
SYSTEMONE_URL=http://127.0.0.1:8765
# 동기 턴에서 병렬로 받아 고를 답 후보 수: 1..3. 없으면 1. 벗어나면 기동하지 않는다.
REPLY_CANDIDATES=1
# 직전 답을 일반 위로로 보는 확률의 하한: 0..1. 없으면 0.5(ADR-0025). 벗어나면 기동하지 않는다.
REPLY_JUDGE_THRESHOLD=0.5
