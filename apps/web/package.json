{
  "name": "@beside-pet/web",
  "version": "0.1.0",
  "private": true,
  "description": "Pet-loss emotional support agent web client (Next.js)",
  "scripts": {
    "predev": "rm -rf public/showcase && cp -R ../../showcase public/showcase",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "prebuild": "rm -rf public/showcase && cp -R ../../showcase public/showcase",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.9",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
