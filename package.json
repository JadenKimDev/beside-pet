{
  "name": "beside-pet",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@polydeukes/adapter-claude-code": "0.18.0",
    "@polydeukes/core": "0.18.0",
    "polydeukes": "0.18.0"
  },
  "scripts": {
    "test": "pnpm -s lint && pnpm -r typecheck && pnpm -r --if-present test && pnpm -s test:stack",
    "test:stack": "dev-tools/scripts/cargo.sh clippy --all-targets -- -D warnings && dev-tools/scripts/cargo.sh test",
    "lint": "biome check .",
    "dev": "dev-tools/scripts/dev.sh",
    "db:up": "dev-tools/scripts/db.sh up",
    "db:down": "dev-tools/scripts/db.sh down",
    "db:status": "dev-tools/scripts/db.sh status",
    "prod:up": "infra/docker/scripts/prod-up.sh",
    "prod:down": "infra/docker/scripts/prod-down.sh",
    "deploy:prod": "infra/scripts/deploy.sh",
    "sandbox:up": "infra/docker/scripts/sandbox-up.sh",
    "sandbox:down": "infra/docker/scripts/sandbox-down.sh",
    "sandbox:reset": "infra/docker/scripts/sandbox-reset.sh",
    "browser:tab": "dev-tools/scripts/browser-tab.sh",
    "prd:push": "node dev-tools/src/cli.ts prd:push",
    "prd:pull": "node dev-tools/src/cli.ts prd:pull",
    "prd:pane": "dev-tools/scripts/prd-pane.sh",
    "wt:create": "dev-tools/scripts/wt.sh create",
    "wt:pane": "dev-tools/scripts/wt.sh pane",
    "wt:finish": "dev-tools/scripts/wt.sh finish",
    "wt:remove": "dev-tools/scripts/wt.sh remove",
    "wt:status": "dev-tools/scripts/wt.sh status",
    "ledger:new": "node dev-tools/src/cli.ts ledger:new",
    "work": "node dev-tools/src/cli.ts work",
    "ledger:red": "node dev-tools/src/cli.ts ledger:red",
    "ledger:verify": "node dev-tools/src/cli.ts ledger:verify",
    "finish": "node dev-tools/src/cli.ts finish",
    "ledger:status": "node dev-tools/src/cli.ts ledger:status",
    "ledger:outcomes": "node dev-tools/src/cli.ts ledger:outcomes",
    "ledger:accuracy": "node dev-tools/src/cli.ts ledger:accuracy",
    "docs:index": "node --no-warnings=ExperimentalWarning dev-tools/src/cli.ts docs:index",
    "docs:search": "node --no-warnings=ExperimentalWarning dev-tools/src/cli.ts docs:search",
    "docs:list": "node --no-warnings=ExperimentalWarning dev-tools/src/cli.ts docs:list",
    "docs:neighbors": "node --no-warnings=ExperimentalWarning dev-tools/src/cli.ts docs:neighbors",
    "chat:eval": "node dev-tools/src/cli.ts chat:eval",
    "issue:label": "node dev-tools/src/cli.ts issue:label",
    "issue:comment": "node dev-tools/src/cli.ts issue:comment",
    "runner:report": "node dev-tools/src/cli.ts runner:report",
    "decision:label": "cd dev-tools/decision && uv run python -m decision.label",
    "decision:synth": "cd dev-tools/decision && uv run python -m decision.synth",
    "decision:split": "cd dev-tools/decision && uv run python -m decision.split",
    "decision:eval": "cd dev-tools/decision && uv run python -m decision.eval",
    "decision:train": "cd dev-tools/decision && uv run python -m decision.train",
    "llm:shim": "python3 dev-tools/scripts/claude-shim.py"
  }
}
